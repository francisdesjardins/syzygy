{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{const f=JSON.parse(d).tool_input.file_path;require('child_process').execSync('yarn oxfmt --no-error-on-unmatched-pattern '+JSON.stringify(f),{stdio:'inherit'})})\"",
            "timeout": 30,
            "statusMessage": "Formatting with oxfmt"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git stash clear:*)",
      "Bash(git stash drop:*)",
      "Bash(git rebase:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git checkout:*)",
      "Bash(docker system prune:*)",
      "Bash(npm publish:*)",
      "Bash(yarn npm publish:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  }
}
