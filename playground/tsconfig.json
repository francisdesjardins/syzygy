{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // The program legitimately spans two workspaces: the demo consumes the library through its
    // public specifiers, aliased to source, so the common root is the repo rather than this folder.
    "rootDir": "..",
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "antumbra": ["../src/index.ts"],
      "antumbra/react": ["../src/react.ts"],
      "antumbra/solid": ["../src/solid.ts"],
      "antumbra/vanilla": ["../src/vanilla.ts"]
    }
  },
  "include": ["src/**/*", "vite-plugins/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
