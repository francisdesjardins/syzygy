{
  "name": "penumbra",
  "version": "1.0.0",
  "description": "The portable half of a design system: scale, rhythm, motion and stacking with no colour in them, and a neutral skin with no brand in it.",
  "keywords": [
    "css",
    "custom-properties",
    "design-system",
    "design-tokens",
    "theming"
  ],
  "license": "MIT",
  "author": "Francis Desjardins <francis.desjardins@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francisdesjardins/syzygy.git",
    "directory": "packages/penumbra"
  },
  "bin": {
    "penumbra-contrast": "./scripts/check-contrast.mjs"
  },
  "files": [
    "tokens.system.css",
    "tokens.skin.base.css",
    "scripts/check-contrast.mjs"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./tokens.system.css": "./tokens.system.css",
    "./tokens.skin.base.css": "./tokens.skin.base.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "node scripts/check-tokens.mjs && node scripts/check-contrast.mjs",
    "test": "echo \"penumbra: no-op — pure CSS tokens; the contract is asserted by check (scripts/check-tokens.mjs)\""
  },
  "engines": {
    "node": ">=24"
  }
}
