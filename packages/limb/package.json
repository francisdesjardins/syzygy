{
  "name": "limb",
  "version": "1.0.0",
  "private": true,
  "description": "The framework-free half of a playground: a fuzzy matcher, a contrast calculator and the readable syntax theme built on it.",
  "license": "MIT",
  "author": "Francis Desjardins <francis.desjardins@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francisdesjardins/syzygy.git",
    "directory": "packages/limb"
  },
  "type": "module",
  "exports": {
    "./color-contrast": "./src/color-contrast.ts",
    "./fuzzy-match": "./src/fuzzy-match.ts",
    "./mutex": "./src/mutex.ts",
    "./readable-syntax": "./src/readable-syntax.ts",
    "./shallow-equal": "./src/shallow-equal.ts",
    "./single-flight": "./src/single-flight.ts",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "yarn type-check && yarn lint --deny-warnings && yarn format:check",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "playwright test",
    "test:coverage": "c8 playwright test",
    "type-check": "node node_modules/typescript-7/bin/tsc --noEmit",
    "verify:all": "yarn check && yarn test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "c8": "12.0.0",
    "gnomon": "workspace:^",
    "oxfmt": "0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript-7": "npm:typescript@7.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  }
}
