{
  // The shared strictness is [tsconfig.base.json](../../tsconfig.base.json) at the repository root.
  //
  // No `jsx` and no `allowImportingTsExtensions`: nothing here renders, which is this package's
  // entry rule rather than an omission.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    "types": ["node"]
  },
  "include": ["src/**/*", "playwright.config.ts"],
  "exclude": ["node_modules"]
}
