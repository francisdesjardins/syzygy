{
  // The shared strictness is [tsconfig.base.json](../../tsconfig.base.json) at the repository root.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist"
  },
  // The config files sit beside `src/`, not in it — outside the program they are untyped to `tsc`,
  // the editor and `oxlint --type-aware` alike. `rootDir` is emit's, and this program is `noEmit`.
  "include": ["src/**/*", "playwright.config.ts", "vite.config.esm.ts"],
  "exclude": ["node_modules", "dist", "playground"]
}
