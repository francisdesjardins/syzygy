{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",

  // The rules, the plugins and the overrides every workspace shares are in the repository root's
  // [.oxlintrc.json](../../.oxlintrc.json); what is below is antumbra's alone. A child's
  // `overrides` are appended to the root's rather than replacing them.
  "extends": ["../../.oxlintrc.json"],
  "rules": {
    // The MUI barrels re-export thousands of modules, and one `import { Box } from '@mui/material'`
    // puts the whole graph back into every compile. Per-module imports keep the graph at what the
    // playground actually uses; this is the lock that keeps the codemod from regressing one file
    // at a time. It is here rather than at the root because this is the only workspace that depends
    // on MUI, and a restriction on an import nobody can write is a rule that cannot fail.
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@mui/material",
            "message": "Import the module, not the barrel: @mui/material/<Component> (styles/types via @mui/material/styles)."
          },
          {
            "name": "@mui/icons-material",
            "message": "Import the icon module: @mui/icons-material/<Icon>."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["playground/**/*.{ts,tsx}"],
      "rules": {
        "react/only-export-components": ["warn", { "allowConstantExport": true }]
      }
    },
    {
      // The microfrontend demo, served verbatim from `public/` with no build step — the import map
      // is what resolves `antumbra`, which is the demonstration. Shipped code a code viewer prints
      // is exactly the code worth linting, and the two logs on the page are the demo's output.
      "files": ["playground/public/mfe/**/*.js"],
      "rules": {
        "no-console": "error"
      }
    },
    {
      // JSDoc `@example` blocks, extracted by `gnomon-examples`. A doc example is code a
      // reader copies, so it is linted — but as a snippet: it shows a call and stops, leaves
      // bindings unread, and leans on `declare`d `any` stand-ins for the app around it. It also
      // uses concise arrows on purpose, which is the opposite of what the library asks. What stays
      // on is the class of rule that would make an example teach a bug.
      //
      // `generated/` is not committed, so this matches nothing until the script runs.
      "files": ["scripts/examples/generated/**/*.tsx"],
      "rules": {
        "arrow-body-style": "off",
        "curly": "off",
        // An elliptical example shows one option of an object (`render: (ctx) => …`) and stops,
        // which parses standalone as a label followed by an expression. That is the illustration
        // working as intended; the type pass is what still holds it to the library's API.
        "no-unused-labels": "off",
        "no-unused-expressions": "off",
        // Two findings about the harness rather than the example. The generated module carries an
        // `export {}` so `moduleDetection: force` has something to see, and the snippet is wrapped
        // in an `async` function so it can host an awaited call site — which makes every hook call
        // in an example structurally "called in an async function".
        "typescript/no-useless-empty-export": "off",
        "react-hooks/rules-of-hooks": "off",
        "typescript/no-unused-vars": "off",
        "typescript/no-explicit-any": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/require-await": "off",
        "typescript/no-unnecessary-condition": "off",
        "typescript/no-confusing-void-expression": "off",
        "no-console": "off"
      }
    }
  ],
  // **Not inherited through `extends`** — not even by a child that declares none — so the list is
  // written out here and in every sibling, identically. Measured against oxlint 1.83.0.
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/playwright-report/**",
    "**/playwright/.cache/**",
    "**/playwright/.cache-coverage/**",
    "**/test-results/**",
    "**/coverage/**",
    "playground/dist/**",
    "**/.vite/**",
    "**/*.d.ts",
    ".yarn/**"
  ]
}
