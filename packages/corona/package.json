{
  "name": "corona",
  "version": "1.0.0",
  "private": true,
  "description": "What a playground shows of a library, minus the part that is about which library it is: the API reference, the design-system tables, and the way back to the site.",
  "license": "MIT",
  "author": "Francis Desjardins <francis.desjardins@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francisdesjardins/syzygy.git",
    "directory": "packages/corona"
  },
  "type": "module",
  "exports": {
    "./api": "./src/api/index.ts",
    "./code": "./src/code/index.ts",
    "./contract": "./src/api/contract.ts",
    "./icons": "./src/icons/index.ts",
    "./mascot": "./src/mascot/index.ts",
    "./package.json": "./package.json",
    "./shell": "./src/shell/index.ts",
    "./site": "./src/site/index.ts",
    "./src/*": "./src/*",
    "./surface": "./src/surface/index.ts",
    "./theme": "./src/theme/index.ts",
    "./tokens": "./src/tokens/index.ts"
  },
  "scripts": {
    "check": "yarn type-check && yarn lint --deny-warnings && yarn format:check && yarn check:tokens && yarn check:tokens:used && yarn doc-budget",
    "type-check": "node node_modules/typescript-7/bin/tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "yarn test:unit && yarn test:component",
    "test:unit": "playwright test -c playwright.config.ts --project=unit",
    "test:unit:coverage": "c8 playwright test -c playwright.config.ts --project=unit",
    "test:component": "playwright test -c playwright.config.ts --project=component",
    "test:component:coverage": "CT_COVERAGE=1 playwright test -c playwright.config.ts --project=component && gnomon-ct-coverage-report",
    "dev": "vite",
    "verify:all": "yarn check && yarn test",
    "doc-budget": "gnomon-doc-budget",
    "check:tokens": "node scripts/check-token-coverage.mjs",
    "check:tokens:used": "gnomon-token-usage --declares ../penumbra/tokens.system.css ../penumbra/tokens.skin.base.css ../umbra/playground/src/app/styles/tokens.skin.css -- src"
  },
  "dependencies": {
    "limb": "workspace:^",
    "penumbra": "workspace:^",
    "react-syntax-highlighter": "^16.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tanstack/react-router": "^1.170.36",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "c8": "12.0.0",
    "gnomon": "workspace:^",
    "oxfmt": "0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript-7": "npm:typescript@7.0.2",
    "vite": "^8.3.0"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.170.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-router": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  }
}
