{
  "name": "corona",
  "version": "1.0.0",
  "private": true,
  "description": "What a playground shows of a library, minus the part that is about which library it is: the API reference, the design-system tables, and the way back to the site.",
  "license": "MIT",
  "author": "Francis Desjardins <francis.desjardins@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francisdesjardins/syzygy.git",
    "directory": "packages/corona"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api/index.ts",
    "./contract": "./src/api/contract.ts",
    "./mascot": "./src/mascot/index.ts",
    "./shell": "./src/shell/index.ts",
    "./site": "./src/site/index.ts",
    "./theme": "./src/theme/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "yarn type-check && yarn lint --deny-warnings && yarn format:check && yarn check:tokens",
    "type-check": "node node_modules/typescript-7/bin/tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "echo \"corona: no-op — no test files yet; the viewer is exercised by antumbra's and umbra's smoke suites\"",
    "verify:all": "yarn check",
    "check:tokens": "node scripts/check-token-coverage.mjs"
  },
  "dependencies": {
    "limb": "workspace:^",
    "penumbra": "workspace:^"
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.170.36",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "oxfmt": "0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript-7": "npm:typescript@7.0.2"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.170.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  }
}
