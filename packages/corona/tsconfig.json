{
  // The shared strictness is [tsconfig.base.json](../../tsconfig.base.json) at the repository root.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `DOM.Iterable` because the viewer walks a `NodeList` rather than indexing one.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
