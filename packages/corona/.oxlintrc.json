{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",

  // The whole lint surface is the repository root's [.oxlintrc.json](../../.oxlintrc.json). This
  // package adds nothing to it, which is what the file says by being this short.
  "extends": ["../../.oxlintrc.json"],
  // **Not inherited through `extends`** — not even by a child that declares none — so the list is
  // written out here and in every sibling, identically. Measured against oxlint 1.83.0.
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/playwright-report/**",
    "**/playwright/.cache/**",
    "**/playwright/.cache-coverage/**",
    "**/test-results/**",
    "**/coverage/**",
    "playground/dist/**",
    "**/.vite/**",
    "**/*.d.ts",
    ".yarn/**"
  ]
}
