{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // The program legitimately spans two workspaces: the demo consumes the library through its
    // public specifiers, aliased to source, so the common root is the repo rather than this folder.
    "rootDir": "..",
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "umbra": ["../src/index.ts"],
      "umbra/react": ["../src/react.ts"],
      "umbra/solid": ["../src/solid.ts"],
      "umbra/plain": ["../src/plain.ts"],
      // Subpaths, for the harnesses that live beside the code they exercise. Listed last so the
      // four exact entries above still win for the entry points themselves.
      "umbra/*": ["../src/*"]
    }
  },
  "include": ["src/**/*", "vite-plugins/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
