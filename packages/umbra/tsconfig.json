{
  // The shared strictness is [tsconfig.base.json](../../tsconfig.base.json) at the repository root.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    // React's transform, for the React binding. The Solid binding deliberately writes no JSX at
    // all — one program cannot hold two JSX factories, and Solid's runtime builds components just
    // as well through `createComponent`.
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist"
  },
  "include": ["src/**/*", "playwright.config.ts", "vite.config.esm.ts"],
  "exclude": ["node_modules", "dist", "playground"]
}
