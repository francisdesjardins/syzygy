{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",

  // The rules, the plugins and the overrides every workspace shares are in the repository root's
  // [.oxlintrc.json](../../.oxlintrc.json); what is below is umbra's alone. A child's `overrides`
  // are appended to the root's rather than replacing them.
  "extends": ["../../.oxlintrc.json"],
  "overrides": [
    {
      "files": ["playground/**/*.{ts,tsx}"],
      "rules": {
        "react/only-export-components": ["warn", { "allowConstantExport": true }]
      }
    },
    {
      // Story harnesses export a mount function and no component, which is what the component
      // suite asks them for. Fast refresh cannot work on that shape and does not need to: a story
      // is reloaded by the test navigating to it.
      "files": ["playground/src/pages/stories/**/*.{ts,tsx}"],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      // The frame's fragments are shipped code a code viewer prints, so the two logs on the page
      // are the demo's output rather than a leftover — `error` rather than the root's `warn`.
      "files": ["playground/public/mfe/**/*.js"],
      "rules": {
        "no-console": "error"
      }
    },
    {
      // Type fixtures are written to be rejected. A `@ts-expect-error` line is a bare expression by
      // construction, and a deliberately wrong `run` is a concise arrow because the point is the
      // return type rather than the body.
      "files": ["type-fixtures/**/*.test-d.ts"],
      "rules": {
        "arrow-body-style": "off",
        "no-unused-expressions": "off",
        "typescript/no-unused-expressions": "off",
        "typescript/no-unsafe-call": "off"
      }
    }
  ],
  // **Not inherited through `extends`** — not even by a child that declares none — so the list is
  // written out here and in every sibling, identically. Measured against oxlint 1.83.0.
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/playwright-report/**",
    "**/playwright/.cache/**",
    "**/playwright/.cache-coverage/**",
    "**/test-results/**",
    "**/coverage/**",
    "playground/dist/**",
    "**/.vite/**",
    "**/*.d.ts",
    ".yarn/**"
  ]
}
