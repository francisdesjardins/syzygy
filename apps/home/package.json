{
  "name": "home",
  "version": "1.0.0",
  "private": true,
  "description": "francisdesjardins.ca — the front door, and the index of what the packages here are.",
  "license": "MIT",
  "author": "Francis Desjardins <francis.desjardins@gmail.com>",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "yarn type-check && yarn lint --deny-warnings && yarn format:check && yarn check:contrast && yarn check:literals && yarn check:head",
    "type-check": "node node_modules/typescript-7/bin/tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "echo \"home: no-op — no test files yet\"",
    "verify:all": "yarn check && yarn build",
    "check:contrast": "penumbra-contrast src/styles/tokens.skin.css",
    "check:literals": "node scripts/check-literals.mjs",
    "check:head": "node scripts/check-head.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "penumbra": "workspace:^",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript-7": "npm:typescript@7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=24"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  }
}
